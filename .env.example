# ============================================================
# CLAVIO AKWA - ENVIRONMENT CONFIGURATION
# ============================================================
# 
# Copy this file to .env.local and fill in your actual values
# Command: cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to version control!
# The .gitignore file should exclude all .env.local files.
# ============================================================

# Monetbil Payment Credentials
# Get these from your Monetbil dashboard: https://app.monetbil.com
VITE_MONETBIL_SERVICE_KEY=your_service_key_here
VITE_MONETBIL_SERVICE_SECRET=your_service_secret_here

# Environment: 'test' for sandbox testing, 'production' for live payments
VITE_MONETBIL_ENVIRONMENT=test

# Restaurant WhatsApp number for order dispatch
# Format: country code + number (no + or spaces)
# Example: 2376XXXXXXXX for Cameroon
# REQUIRED for WhatsApp auto-dispatch after payment
# If not set, payment will still work but WhatsApp notification will be skipped
VITE_RESTAURANT_WHATSAPP=237600000000
